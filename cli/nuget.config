<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    NuGet feeds for Attestree.
    Per Plan Unit 1.1: nuget.org for public packages + private feed placeholder
    for closed-source Wep packages.

    The <wep-private> feed is a placeholder. Once an internal Azure Artifacts /
    GitHub Packages / private NuGet feed is provisioned (Phase 1, after the
    cross-runtime spike Unit 0.3 stabilizes), update the value attribute and
    set up service-principal credentials via the CI signing pipeline (Unit 1.2).
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="wep-private" value="https://nuget.example.invalid/wep/v3/index.json" protocolVersion="3" />
  </packageSources>

  <disabledPackageSources>
    <!--
      Private feed disabled by default until provisioned + credentialed.
      Enable per-developer via `dotnet nuget enable source wep-private` once
      the feed is live and the developer has authenticated.
    -->
    <add key="wep-private" value="true" />
  </disabledPackageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="wep-private">
      <package pattern="Wep.*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    signatureValidationMode is left at the NuGet default (accept). 'require' rejects
    perfectly-fine Microsoft-signed transitive packages whose signing certs predate
    any trustedSigners pin we add, which makes the v1 restore brittle. The
    end-of-pipeline supply-chain guarantee for Wep artifacts is the Authenticode
    + SLSA-2 + Rekor chain in Plan Unit 1.2, not per-NuGet-package signature pinning
    on build-time dependencies. Revisit at Phase 12 SOC 2 prep if a stronger build-
    dependency posture is required (e.g., switch to a private mirror with curated
    signature manifests).
  -->

</configuration>
